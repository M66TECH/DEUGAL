{
  "name": "@m66tech/deugal",
  "version": "0.6.0",
  "description": "Deugal — a fast, local-first snippet manager for the terminal.",
  "license": "MIT",
  "author": "M66TECH <https://github.com/M66TECH>",
  "homepage": "https://github.com/M66TECH/DEUGAL#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/M66TECH/DEUGAL.git"
  },
  "bugs": {
    "url": "https://github.com/M66TECH/DEUGAL/issues"
  },
  "keywords": [
    "snippets",
    "cli",
    "developer-tools",
    "productivity",
    "typescript"
  ],
  "type": "module",
  "bin": {
    "deugal": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "picocolors": "^1.1.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
